{
  "manifest_version": 3,
  "name": "JobOS — AI Job Tracker & Autofill",
  "version": "3.1.0",
  "description": "Capture jobs from any site. Autofill any ATS. Track everything. Powered by JobOS AI.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/in/*",
        "https://www.linkedin.com/company/*",
        "https://www.linkedin.com/school/*",
        "https://www.indeed.com/*",
        "https://pk.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://www.naukri.com/*",
        "https://www.rozee.pk/*",
        "https://jobs.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://*.taleo.net/*",
        "https://app.jobos.dev/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "fab.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://job.zeeshare.com/*",
        "https://app.jobos.dev/*",
        "https://*/*"
      ],
      "js": [
        "jobos-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "supabase-js.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}