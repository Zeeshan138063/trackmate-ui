{
  "manifest_version": 3,
  "name": "TrackMate Job Capture",
  "version": "1.0.0",
  "description": "Capture job details and screenshots from job posting pages",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.linkedin.com/in/*",
        "https://www.indeed.com/viewjob*",
        "https://www.glassdoor.com/Job/*",
        "https://jobs.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://*/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "http://*:8080/*",
        "http://*:8081/*",
        "http://*:5173/*"
      ],
      "js": [
        "trackmate-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}