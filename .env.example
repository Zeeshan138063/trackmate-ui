# Production Deployment Variables for Coolify
# NOTE: These must be set in the "Build Environment Variables" section in Coolify
# because Vite bundles them at build time.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: URL to redirect users to after auth (e.g. for localhost testing with deployed backend)
# If not set, defaults to window.location.origin
# VITE_SITE_URL=https://your-deployed-app.com
